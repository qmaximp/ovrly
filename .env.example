# Публичный адрес сайта: canonical, sitemap, robots и Open Graph.
# На хостинге задайте реальный домен (без слэша на конце).
# NEXT_PUBLIC_SITE_URL=https://your-domain.example

# PostgreSQL (локальный на VDS или managed)
# DATABASE_URL=postgresql://ovrly:password@127.0.0.1:5433/ovrly

# Переходный fallback для комнат: если комнаты нет в БД, поднять её из data/rooms
# и сохранить в Postgres. После cutover можно выключить.
# ROOMS_JSON_FALLBACK=0

# Cloudflare R2 для медиа с ПК (без этих переменных файлы идут base64 в комнату).
# Публичный доступ к bucket нужен для <img>/<video> и волны звука на оверлее.
# R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# R2_BUCKET=ovrly-media
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_PUBLIC_URL=https://media.ovrly.ru
# Абсолютный лимит на один файл (по умолчанию 64 МБ)
# MEDIA_MAX_BYTES=67108864

# Twitch OAuth (https://dev.twitch.tv/console — ваше приложение)
# Скопируйте этот файл в .env.local и заполните значения.
# OAuth Redirect URLs приложения: http://localhost:3000/api/auth/twitch/callback
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Если порт отличается от 3000 — укажите redirect URL явно:
# TWITCH_REDIRECT_URI=http://localhost:3001/api/auth/twitch/callback
